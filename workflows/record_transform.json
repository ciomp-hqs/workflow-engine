{
  "id": "record_transform",
  "version": 1,
  "description": "输入记录 -> 校验字段 -> 按记录类型条件分支 -> 不同数据转换 -> 汇合输出结果 (不调用模型)",
  "plugins": ["wfengine.plugins.records", "wfengine.plugins.notify"],
  "on_failure": "fail_fast",
  "nodes": [
    {"id": "validate", "type": "function",
     "params": {"function": "validate_records",
                "schemas": {
                  "order": {"order_id": "str", "amount": "positive_number", "currency": "enum:CNY|USD|cny|usd"},
                  "user": {"user_id": "str", "name": "str", "email": "email"}}},
     "inputs": {"record_type": "$input.record_type", "records": "$input.records"},
     "idempotent": true},
    {"id": "route", "type": "condition", "depends_on": ["validate"],
     "params": {"switch": "$nodes.validate.output.record_type",
                "cases": {"order": "orders", "user": "users"}}},
    {"id": "transform_orders", "type": "function", "depends_on": ["route"],
     "when": {"eq": ["$nodes.route.output.branch", "orders"]},
     "params": {"function": "transform_orders"},
     "inputs": {"items": "$nodes.validate.output.valid"}, "idempotent": true},
    {"id": "transform_users", "type": "function", "depends_on": ["route"],
     "when": {"eq": ["$nodes.route.output.branch", "users"]},
     "params": {"function": "transform_users"},
     "inputs": {"items": "$nodes.validate.output.valid"}, "idempotent": true},
    {"id": "merge", "type": "function", "depends_on": ["transform_orders", "transform_users"],
     "join": "any_success",
     "params": {"function": "merge_results"},
     "inputs": {"record_type": "$nodes.validate.output.record_type",
                "branches": {"orders": "$nodes.transform_orders.output", "users": "$nodes.transform_users.output"},
                "invalid": "$nodes.validate.output.invalid"}, "idempotent": true},
    {"id": "write_output", "type": "function", "depends_on": ["merge"],
     "params": {"function": "write_json_output"},
     "inputs": {"result": "$nodes.merge.output"}, "idempotent": true},
    {"id": "alert_invalid", "type": "notify", "depends_on": ["validate"],
     "when": {"gt": ["$nodes.validate.output.invalid_count", 0]},
     "params": {"message": "记录校验发现 {count} 条无效记录", "level": "warn"},
     "inputs": {"count": "$nodes.validate.output.invalid_count"}}
  ]
}
