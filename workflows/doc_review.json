{
  "id": "doc_review",
  "version": 1,
  "description": "输入文档 -> 并行[提取要点, 敏感内容检查] -> 汇总 -> 有敏感内容则人工确认 -> 写入本地报告 -> 通知",
  "plugins": ["wfengine.plugins.docs", "wfengine.plugins.notify"],
  "on_failure": "fail_fast",
  "nodes": [
    {"id": "extract", "type": "llm",
     "params": {"task": "extract_points", "max_points": 3},
     "inputs": {"text": "$input.doc.text"},
     "retry": {"max_attempts": 3, "backoff_seconds": 0.1, "backoff_multiplier": 2},
     "timeout_seconds": 10},
    {"id": "check", "type": "llm",
     "params": {"task": "sensitive_check"},
     "inputs": {"text": "$input.doc.text"},
     "retry": {"max_attempts": 3, "backoff_seconds": 0.1},
     "timeout_seconds": 10},
    {"id": "summarize", "type": "function", "depends_on": ["extract", "check"],
     "params": {"function": "summarize_doc"},
     "inputs": {"title": "$input.doc.title", "points": "$nodes.extract.output.points",
                "sensitive": "$nodes.check.output.sensitive", "findings": "$nodes.check.output.findings"},
     "idempotent": true},
    {"id": "gate", "type": "condition", "depends_on": ["summarize"],
     "params": {"expr": {"ref": "$nodes.summarize.output.sensitive"}}},
    {"id": "approve", "type": "human_approval", "depends_on": ["gate"],
     "when": {"ref": "$nodes.gate.output.result"},
     "params": {"title": "敏感文档报告发布审批", "fields": ["title", "summary", "findings"]},
     "inputs": {"title": "$nodes.summarize.output.title", "summary": "$nodes.summarize.output.summary",
                "findings": "$nodes.summarize.output.findings"}},
    {"id": "report", "type": "function", "depends_on": ["summarize", "approve"],
     "join": "none_failed",
     "params": {"function": "write_report"},
     "inputs": {"summary": "$nodes.summarize.output", "approval": "$nodes.approve.output"},
     "idempotent": true},
    {"id": "notify_done", "type": "notify", "depends_on": ["report"],
     "params": {"message": "文档审阅报告已生成: {path}（经过审批: {approved}）", "channel": "outbox"},
     "inputs": {"path": "$nodes.report.output.path", "approved": "$nodes.report.output.approved"}}
  ]
}
